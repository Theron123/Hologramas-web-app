# HoloForge Environment Variables
# Copy this file to .env.local and add your API keys

# Gemini API Key (Gemini 2.5 Flash — preferred provider for product analysis + copy generation)
# Get it at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI API Key (GPT-4o Vision for product analysis + copy generation — used if Gemini is not configured)
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# fal.ai API Key (Image-to-3D generation with Trellis / TripoSR)
# Get it at: https://fal.ai/dashboard
FAL_KEY=

# Hugging Face token (optional — raises the free/keyless Gradio Spaces rate limit used when
# FAL_KEY is not configured)
HF_TOKEN=

# App Settings
NEXT_PUBLIC_APP_NAME=HoloForge
NEXT_PUBLIC_APP_ENV=development

# ── Optional overrides (all have working defaults; only set these if you need to) ──

# Model names used by each provider. Override if the default gets deprecated/renamed.
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o

# Comma-separated FAL_KEY prefixes/values treated as "not configured" (falls back to the free
# Gradio adapter instead of sending a doomed request with a known placeholder key).
# FAL_KEY_DISABLED_PREFIXES=locked,f54465d8-

# Free, keyless Hugging Face Spaces used when FAL_KEY isn't active. Override if either Space
# gets renamed, deprecated, or rate-limited.
# GRADIO_TRELLIS_SPACE=microsoft/TRELLIS.2
# GRADIO_TRIPOSR_SPACE=stabilityai/TripoSR

# Scales every Gradio step timeout (connect/preprocess/generate/etc.) up or down, e.g. 1.5 = 50%
# longer timeouts, for when the free HF Spaces queue is slower than usual.
# GRADIO_TIMEOUT_MULTIPLIER=1

# fal.ai Trellis 2/TripoSR quality knobs — higher sampling steps/guidance strength/texture size
# trade generation time for mesh + texture fidelity. Defaults (set in FalAIImageTo3DAdapter.ts)
# are currently maxed out for quality (~20-25min generations); lower the *_SAMPLING_STEPS to
# e.g. 14 and set FAL_TRELLIS_ENABLE_ESRGAN=false to cut that down to a few minutes instead.
# tex_slat_guidance_strength is the key one for logo/small-print fidelity — it controls how
# closely the generated texture sticks to the source photo's actual colors/detail.
# FAL_TRELLIS_SS_GUIDANCE_STRENGTH=8.5
# FAL_TRELLIS_SHAPE_GUIDANCE_STRENGTH=8.0
# FAL_TRELLIS_TEX_GUIDANCE_STRENGTH=6.0
# FAL_TRELLIS_SS_SAMPLING_STEPS=20
# FAL_TRELLIS_SHAPE_SAMPLING_STEPS=20
# FAL_TRELLIS_TEX_SAMPLING_STEPS=20
# FAL_TRELLIS_TEXTURE_SIZE=4096
# FAL_TRELLIS_RESOLUTION=1536
# FAL_TRELLIS_DECIMATION_TARGET=1000000
# FAL_TRIPOSR_FOREGROUND_RATIO=0.85

# Set to 'false' to skip the Real-ESRGAN upscale pass on the input image before Trellis and cut
# generation time — the pass sharpens fine texture detail the model picks up from the source
# photo, at the cost of a full extra fal.ai model call. On by default for max fidelity.
# FAL_TRELLIS_ENABLE_ESRGAN=true
